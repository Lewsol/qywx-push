# 服务器配置（本地开发默认仅供本机访问；生产Compose会显式使用127.0.0.1:12121）
HOST=127.0.0.1
PORT=12121

# HTTPS边界（本地纯HTTP开发可保持false；production环境必须为true）
REQUIRE_HTTPS=false

# REQUIRE_HTTPS=true时必填，必须是无路径的HTTPS源地址
PUBLIC_ORIGIN=

# 可信反向代理IP/CIDR列表；默认生产拓扑仅信任loopback，禁止使用任意信任
TRUSTED_PROXY_CIDRS=loopback

# 仅在确认所有访问都已迁移到HTTPS且无HTTP依赖后启用
ENABLE_HSTS=false

# 数据库配置
DB_PATH=./database/notifier.db

# 加密密钥（必填；请按README生成并安全注入恰好32字节的可打印ASCII，不提供固定示例值）
ENCRYPTION_KEY=

# 管理员Token（必填；至少32字符base64url安全随机值，请使用安全随机值且不要与ENCRYPTION_KEY相同）
ADMIN_TOKEN=

# 应用配置
NODE_ENV=development

# 企业微信API基础URL
WECHAT_API_BASE=https://qyapi.weixin.qq.com 