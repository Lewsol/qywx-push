{
  "name": "wechat-notifier",
  "version": "1.0.0",
  "description": "企业微信通知转发服务 - 类似Server酱的轻量级通知服务",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build:css": "tailwindcss -c tailwind.config.js -i ./src/styles.css -o ./public/styles.css --minify",
    "test": "npm run test:frontend && npm run test:security-logging && npm run test:database-security",
    "test:frontend": "node --test test/frontend-xss.test.js",
    "test:security-logging": "node --test test/security-logging.test.js",
    "test:database-security": "node --test test/database-security-migration.test.js",
    "rotate-key": "node scripts/rotate-encryption-key.js"
  },
  "keywords": [
    "wechat",
    "notification",
    "api",
    "webhook"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=24.14.0 <25"
  },
  "dependencies": {
    "axios": "1.20.0",
    "dotenv": "17.4.2",
    "express": "4.22.3",
    "sqlite3": "6.0.1",
    "wxcrypt": "1.4.3"
  },
  "devDependencies": {
    "daisyui": "4.12.24",
    "jsdom": "29.1.1",
    "nodemon": "3.1.14",
    "tailwindcss": "3.4.19"
  }
}
