{
  "name": "wechat-notifier",
  "version": "1.0.0",
  "description": "企业微信通知转发服务 - 类似Server酱的轻量级通知服务",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build:css": "tailwindcss -c tailwind.config.js -i ./src/styles.css -o ./public/styles.css --minify",
    "test": "npm run test:frontend && npm run test:security-logging",
    "test:frontend": "node --test test/frontend-xss.test.js",
    "test:security-logging": "node --test test/security-logging.test.js",
    "rotate-key": "node scripts/rotate-encryption-key.js"
  },
  "keywords": [
    "wechat",
    "notification",
    "api",
    "webhook"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.5.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "sqlite3": "^5.1.6",
    "uuid": "^9.0.0",
    "wxcrypt": "^1.4.3",
    "xmldom": "^0.6.0"
  },
  "devDependencies": {
    "daisyui": "4.12.24",
    "jsdom": "24.1.3",
    "nodemon": "^3.0.1",
    "tailwindcss": "3.4.17"
  }
}
